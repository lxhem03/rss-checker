# ── Telegram ──────────────────────────────────────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# BotFather token
BOT_TOKEN=123456789:ABCDefgh_your_bot_token

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use the bot
AUTH_USERS=111111111,222222222

# Comma-separated group/channel IDs where commands are accepted
# Groups are negative numbers, e.g. -1001234567890
AUTH_GROUPS=-1001234567890

# ── MongoDB ───────────────────────────────────────────────────────────────────
# MongoDB Atlas example: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB=rss_bot

# ── Download settings ─────────────────────────────────────────────────────────
# Directory for temporary torrent downloads (auto-cleaned after upload)
DOWNLOAD_DIR=/tmp/downloads

# Max simultaneous torrent downloads
MAX_PARALLEL_DOWNLOADS=3

# Pyrogram upload workers (higher = faster parallel uploads)
WORKERS=4

# libtorrent speed limits in bytes/sec (0 = unlimited)
MAX_DOWNLOAD_RATE=0
MAX_UPLOAD_RATE=0

# ── RSS ───────────────────────────────────────────────────────────────────────
# Feed check interval in seconds — must be between 60 and 300
RSS_CHECK_INTERVAL=120
